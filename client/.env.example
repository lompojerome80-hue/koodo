# ============================================================
# Connexion Firebase (Firestore + Authentication)
# Renseigne ces valeurs depuis Firebase Console > Settings > Config
# Si vide, l'application fonctionne en MODE DÉMO (backend local Express).
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# Paiements Mobile Money
#   sandbox (défaut) : simulation locale dans le navigateur,
#                      aucune somme débitée, aucune clé requise.
#   server           : initiation via le serveur (/api/payments/charge),
#                      qui appelle CinetPay en production. Les clés
#                      restent côté serveur (jamais dans le client).
# ============================================================
VITE_PAYMENT_API=sandbox