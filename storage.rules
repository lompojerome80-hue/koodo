rules_version = '2';

// Photos des livreurs (selfie, pièce d'identité) et images d'annonces :
// lecture pour tout utilisateur connecté, écriture par leur propriétaire.
service firebase.storage {
  match /b/{bucket}/o {
    match /koodo/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}