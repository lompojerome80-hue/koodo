# ============================================================
# Koodo API — configuration serveur (copie ce fichier en .env)
# Toutes les valeurs peuvent être omises : l'appli fonctionne en
# mode DÉMO (OTP affiché à l'écran, paiements simulés) sans aucune
# clé. Ces variables ne servent qu'à passer en PRODUCTION.
# ============================================================

# --- Hôte / HTTPS ---
# NODE_ENV=production active les avertissements de sécurité.
# PUBLIC_BASE_URL = ton domaine public (ex. https://prix.koodo.ci) :
#   utilisé comme base du webhook de confirmation de paiement.
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=https://votre-domaine.com
# Origines autorisées pour le CORS (séparées par des virgules).
# Vide = aucune restriction (déconseillé en production).
CORS_ORIGIN=https://votre-domaine.com

# --- Sécurité des jetons ---
# IMPÉRATIF en production : longue chaîne aléatoire (ex. openssl rand -hex 32).
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# --- Connexion OTP par WhatsApp ---
#   simulated (DÉFAUT) : le code est renvoyé à l'app et affiché à
#                        l'écran de démonstration. Aucun envoi réel.
#   whatsapp           : envoi réel via l'API Meta WhatsApp Business
#                        Cloud (numéro métier approuvé + template OTP
#                        validé). Le devCode n'est alors JAMAIS renvoyé.
OTP_MODE=simulated
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=koodo_otp

# --- Paiements Mobile Money (Orange Money / MTN MoMo / Wave / Moov) ---
#   sandbox (DÉFAUT) : aucune somme débitée, références factices.
#   reel             : initiation réelle chez CinetPay (agrégateur CI).
#                      La confirmation du paiement se fait UNIQUEMENT
#                      par webhook (voir verifyWebhookSignature).
PAYMENTS_MODE=sandbox
CINETPAY_TOKEN=
CINETPAY_SITE_ID=
CINETPAY_SECRET=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2